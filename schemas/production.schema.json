{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://songdna.local/schemas/production.schema.json",
  "title": "SongDNA production v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "song", "session", "role_map", "graph", "mastering"],
  "$defs": {
    "automation": {"type": "array", "items": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["start_frame", "end_frame", "parameter", "start", "end"], "properties": {"start_frame": {"type": "integer", "minimum": 0}, "end_frame": {"type": "integer", "minimum": 1}, "parameter": {"enum": ["gain", "pan", "cutoff", "wet"]}, "start": {"type": "number"}, "end": {"type": "number"}}},
      {"type": "object", "additionalProperties": false, "required": ["section", "start_ratio", "end_ratio", "parameter", "start", "end"], "properties": {"section": {"type": "integer", "minimum": 1}, "start_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "end_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "parameter": {"enum": ["gain", "pan", "cutoff", "wet"]}, "start": {"type": "number"}, "end": {"type": "number"}}}
    ]}}
  },
  "properties": {
    "schema": {"const": "songdna-production/v2"},
    "song": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["daw", "sample_rate", "bit_depth"],
      "properties": {
        "daw": {"type": "string", "pattern": ".*\\S.*"},
        "sample_rate": {"type": "integer", "exclusiveMinimum": 0},
        "bit_depth": {"enum": [16, 24, 32]}
      }
    },
    "mastering": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "sample_rate", "bit_depth", "channels", "target_lufs", "lufs_tolerance", "true_peak_dbtp", "fade_frames", "dither", "codec", "mp3_bitrate_kbps"],
      "properties": {
        "version": {"const": "songdna-mastering/v1"},
        "sample_rate": {"const": 48000},
        "bit_depth": {"const": 24},
        "channels": {"const": 2},
        "target_lufs": {"type": "number", "minimum": -70, "maximum": -5},
        "lufs_tolerance": {"type": "number", "exclusiveMinimum": 0, "maximum": 20},
        "true_peak_dbtp": {"type": "number", "minimum": -9, "maximum": 0},
        "fade_frames": {"type": "integer", "minimum": 1, "maximum": 480000},
        "dither": {"const": "none"},
        "codec": {"const": "mp3/lame-cbr"},
        "mp3_bitrate_kbps": {"type": "integer", "minimum": 32, "maximum": 320}
      }
    },
    "role_map": {"type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["origin", "owner", "description"],
        "properties": {
          "origin": {"enum": ["original_composition", "original_midi", "original_synthesis", "self_recorded"]},
          "owner": {"type": "string", "pattern": ".*\\S.*"},
          "description": {"type": "string", "pattern": ".*\\S.*"}
        }
      }
    },
    "graph": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "master_bus", "buses", "nodes"],
      "properties": {
        "version": {"const": "production-graph/v1"},
        "master_bus": {"type": "string", "minLength": 1},
        "buses": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}}},
        "nodes": {"type": "array", "minItems": 1, "items": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["id", "type", "version", "source", "destination", "gain", "pan"], "properties": {"id": {"type": "string", "minLength": 1}, "type": {"const": "gain_pan"}, "version": {"const": "v1"}, "source": {"type": "string"}, "destination": {"type": "string"}, "gain": {"type": "number", "minimum": 0, "maximum": 4}, "pan": {"type": "number", "minimum": -1, "maximum": 1}, "automation": {"$ref": "#/$defs/automation"}}},
          {"type": "object", "additionalProperties": false, "required": ["id", "type", "version", "source", "destination", "cutoff"], "properties": {"id": {"type": "string", "minLength": 1}, "type": {"const": "one_pole_lowpass"}, "version": {"const": "v1"}, "source": {"type": "string"}, "destination": {"type": "string"}, "cutoff": {"type": "number", "minimum": 0.001, "maximum": 1}, "automation": {"$ref": "#/$defs/automation"}}},
          {"type": "object", "additionalProperties": false, "required": ["id", "type", "version", "source", "destination", "key", "amount", "release_frames"], "properties": {"id": {"type": "string", "minLength": 1}, "type": {"const": "sidechain_duck"}, "version": {"const": "v1"}, "source": {"type": "string"}, "destination": {"type": "string"}, "key": {"type": "string"}, "amount": {"type": "number", "minimum": 0, "maximum": 1}, "release_frames": {"type": "integer", "minimum": 1}, "automation": {"$ref": "#/$defs/automation"}}},
          {"type": "object", "additionalProperties": false, "required": ["id", "type", "version", "source", "destination", "wet", "delay_frames"], "properties": {"id": {"type": "string", "minLength": 1}, "type": {"enum": ["delay_send", "reverb_send"]}, "version": {"const": "v1"}, "source": {"type": "string"}, "destination": {"type": "string"}, "wet": {"type": "number", "minimum": 0, "maximum": 1}, "delay_frames": {"type": "integer", "minimum": 1}, "automation": {"$ref": "#/$defs/automation"}}}
        ]}}
      }
    }
  }
}
