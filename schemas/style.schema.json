{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://songdna.local/schemas/style.schema.json",
  "title": "SongDNA style v1",
  "type": "object",
  "required": ["schema", "id", "defaults", "roles", "sections"],
  "properties": {
    "schema": { "const": "songdna-style/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9_]+/v[0-9]+$" },
    "defaults": {
      "type": "object",
      "required": ["ticks_per_beat", "meter_numerator", "meter_denominator"]
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["generator", "channel", "velocity"],
        "properties": {
          "generator": { "enum": ["fixed_note", "chord_pulse", "chord", "motif"] },
          "channel": { "type": "integer", "minimum": 0, "maximum": 15 },
          "velocity": { "type": "integer", "minimum": 1, "maximum": 127 }
        }
      }
    },
    "sections": { "type": "object", "minProperties": 1 }
  }
}

